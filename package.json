{
    "name":  "sdkwork-documents-workspace",
    "private":  true,
    "license": "AGPL-3.0-or-later",
    "type":  "module",
    "packageManager":  "pnpm@10.33.0",
    "dependencies":  {
                         "@sdkwork/app-topology":  "workspace:*"
                     },
    "scripts":  {
                    "stop":  "pnpm exec sdkwork-app stop",
                    "dev":  "pnpm dev:standalone",
                    "dev:server":  "pnpm exec sdkwork-app dev --runtime-target server --deployment-profile standalone",
                    "dev:browser":  "pnpm dev:browser:postgres:standalone",
                    "build":  "pnpm exec sdkwork-app build",
                    "build:browser":  "node tools/ensure-sdk-common-built.mjs \u0026\u0026 pnpm --filter sdkwork-documents-pc build",
                    "test":  "pnpm exec sdkwork-app test",
                    "check":  "pnpm exec sdkwork-app check",
                    "check:architecture-alignment":  "node tools/check_sdkwork_documents_architecture_alignment.mjs",
                    "check:pnpm-script-standard":  "node ../sdkwork-specs/tools/check-pnpm-script-standard.mjs --root . --product-prefix documents,doc",
                    "check:agent-workflow-standard":  "node ../sdkwork-specs/tools/check-agent-workflow-standard.mjs --root .",
                    "verify":  "pnpm exec sdkwork-app verify",
                    "sdk:generate":  "node sdks/standardize-documents-sdk-family.mjs \u0026\u0026 node scripts/generate-documents-sdk.mjs",
                    "sdk:generate:check":  "node sdks/standardize-documents-sdk-family.mjs --check",
                    "sdk:check":  "node sdks/test/verify-sdk-ownership-boundaries.test.mjs",
                    "clean":  "pnpm exec sdkwork-app clean",
                    "api:materialize":  "node sdks/standardize-documents-sdk-family.mjs \u0026\u0026 node tools/materialize-apis-authority.mjs \u0026\u0026 node tools/patch-route-manifest-extensions.mjs",
                    "api:materialize:check":  "node sdks/standardize-documents-sdk-family.mjs --check \u0026\u0026 node tools/materialize-apis-authority.mjs --check",
                    "api:check":  "node sdks/standardize-documents-sdk-family.mjs --check \u0026\u0026 node tools/materialize-apis-authority.mjs --check \u0026\u0026 powershell -ExecutionPolicy Bypass -File tools/verify_phase1.ps1",
                    "db:materialize:contract":  "node ../sdkwork-specs/tools/materialize-database-contract-from-baseline.mjs --root . --baseline database/ddl/baseline/postgres/0001_documents_baseline.sql --module-id documents --owner documents-platform --prefixes documents_ --engines postgres,sqlite",
                    "db:validate":  "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
                    "db:plan":  "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
                    "db:init":  "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
                    "db:migrate":  "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
                    "db:seed":  "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
                    "db:status":  "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
                    "db:drift":  "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
                    "db:drift:check":  "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
                    "db:bootstrap":  "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
                    "topology:validate":  "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json",
                    "topology:plan":  "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs plan --root . --spec specs/topology.spec.json",
                    "test:topology":  "node --test scripts/verify-documents-topology.test.mjs",
                    "test:contract:database":  "node --test tests/contract/database-framework.contract.test.mjs",
                    "test:pc-architecture":  "node --test apps/sdkwork-documents-pc/tests/documents-pc-architecture.contract.test.mjs",
                    "api:assembly:materialize":  "node ../sdkwork-specs/tools/materialize-api-assembly.mjs --root .",
                    "api:assembly:validate":  "node ../sdkwork-specs/tools/validate-api-assembly.mjs --root .",
                    "check:app-composition":  "node ../sdkwork-specs/tools/verify-repo.mjs --root .",
                    "_sdkwork:build":  "cargo build --workspace --release",
                    "_sdkwork:test":  "pnpm topology:validate \u0026\u0026 pnpm test:topology \u0026\u0026 pnpm test:pc-architecture \u0026\u0026 cargo test --workspace \u0026\u0026 node --test tests/contracts/architecture_alignment.test.mjs tests/contract/database-framework.contract.test.mjs sdks/test/verify-sdk-ownership-boundaries.test.mjs",
                    "_sdkwork:check":  "pnpm run check:app-composition \u0026\u0026 pnpm check:architecture-alignment \u0026\u0026 pnpm check:pnpm-script-standard \u0026\u0026 pnpm check:agent-workflow-standard \u0026\u0026 pnpm db:validate \u0026\u0026 pnpm test:pc-architecture \u0026\u0026 pnpm --filter sdkwork-documents-pc typecheck",
                    "_sdkwork:verify":  "node tools/clean-generated-sdk-artifacts.mjs \u0026\u0026 node tools/materialize_phase1_contracts.mjs \u0026\u0026 node tools/materialize_phase1_contracts.mjs --check \u0026\u0026 node sdks/standardize-documents-sdk-family.mjs \u0026\u0026 node tools/materialize-apis-authority.mjs \u0026\u0026 node tools/patch-route-manifest-extensions.mjs \u0026\u0026 powershell -ExecutionPolicy Bypass -File tools/verify_phase1.ps1 \u0026\u0026 pnpm check \u0026\u0026 pnpm build:browser \u0026\u0026 pnpm topology:validate \u0026\u0026 pnpm test:topology \u0026\u0026 cargo fmt -- --check \u0026\u0026 cargo clippy --workspace --tests -- -D warnings \u0026\u0026 cargo test --workspace \u0026\u0026 node --test tests/contracts/architecture_alignment.test.mjs tests/contract/database-framework.contract.test.mjs sdks/test/verify-sdk-ownership-boundaries.test.mjs \u0026\u0026 pnpm run check:app-composition",
                    "_sdkwork:clean":  "node tools/clean-generated-sdk-artifacts.mjs \u0026\u0026 cargo clean",
                    "dev:standalone":  "pnpm exec sdkwork-app dev --deployment-profile standalone",
                    "dev:cloud":  "pnpm exec sdkwork-app dev --deployment-profile cloud",
                    "dev:server:postgres:standalone":  "pnpm exec sdkwork-app dev --runtime-target server --deployment-profile standalone",
                    "dev:server:sqlite:standalone":  "node scripts/documents-dev.mjs --target server --deployment-profile standalone --database sqlite --dev-env-file configs/topology/standalone.development.env",
                    "dev:server:cloud":  "pnpm exec sdkwork-app dev --runtime-target server --deployment-profile cloud",
                    "dev:browser:postgres:standalone":  "pnpm exec sdkwork-app dev --runtime-target browser --deployment-profile standalone",
                    "dev:browser:postgres:standalone:local":  "node scripts/documents-dev.mjs --target browser-only --deployment-profile standalone --database postgres --dev-env-file configs/topology/standalone.development.env"
                },
    "exports":  {
                    ".":  {
                              "types":  "./src/index.ts",
                              "import":  "./src/index.ts",
                              "default":  "./src/index.ts"
                          }
                }
}
