{
  "name": "@sdkwork/documents-pc-api-reference",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SDKWork Documents PC API reference browser and playground.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./openapiTypes": {
      "import": "./src/openapiTypes.ts",
      "types": "./src/openapiTypes.ts"
    },
    "./apiReferenceSchemaTabs": {
      "import": "./src/apiReferenceSchemaTabs.ts",
      "types": "./src/apiReferenceSchemaTabs.ts"
    },
    "./openapiSchemaRuntime": {
      "import": "./src/openapiSchemaRuntime.ts",
      "types": "./src/openapiSchemaRuntime.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sdkwork/documents-pc-commons": "workspace:*",
    "@sdkwork/utils": "workspace:*",
    "lucide-react": "^0.511.0",
    "motion": "^12.38.0",
    "react": "^19.1.0",
    "react-i18next": "^15.5.2",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.8.2"
  },
  "sdkwork": {
    "workspace": "sdkwork-documents",
    "architecture": "pc-react",
    "domain": "content",
    "capability": "api-reference",
    "surface": "pc-feature",
    "status": "ready"
  }
