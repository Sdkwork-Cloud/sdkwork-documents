# Safe app-surface runtime env template for SDKWork Documents PC.
# Browser-visible keys use the VITE_ prefix per ENVIRONMENT_SPEC.md.

VITE_SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_DOCUMENTS_ENVIRONMENT=development
VITE_SDKWORK_DOCUMENTS_CONFIG_PROFILE=dev
VITE_SDKWORK_DOCUMENTS_BUILD_MODE=development
VITE_SDKWORK_DOCUMENTS_RUNTIME_TARGET=browser
VITE_SDKWORK_DOCUMENTS_DEV_SAME_ORIGIN_API=true
VITE_SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18084
VITE_SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18084
VITE_SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18084
VITE_SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
VITE_SDKWORK_DOCUMENTS_APP_API_BASE_URL=/app/v3/api
VITE_SDKWORK_DOCUMENTS_BACKEND_API_BASE_URL=/backend/v3/api
VITE_SDKWORK_DOCUMENTS_OPEN_API_BASE_URL=/doc/v3/api
VITE_SDKWORK_DOCUMENTS_PC_DEV_PORT=3902
VITE_TOOL_API_ENABLED=false

# SDKWork private bootstrap credential (blank in tracked files).
SDKWORK_ACCESS_TOKEN=
