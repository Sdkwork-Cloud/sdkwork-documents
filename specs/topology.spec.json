{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-documents",
  "archetype": "application-http-gateway",
  "profileRoot": "configs/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "production"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production",
    "gatewayBind": "127.0.0.1:3900"
  },
  "profileFiles": {
    "standalone.development": "configs/topology/standalone.development.env",
    "standalone.production": "configs/topology/standalone.production.env",
    "cloud.development": "configs/topology/cloud.development.env",
    "cloud.production": "configs/topology/cloud.production.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_DOCUMENTS_ENVIRONMENT",
    "profileId": "SDKWORK_DOCUMENTS_PROFILE_ID",
    "clientDeploymentProfile": "VITE_SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE",
    "standaloneGatewayBind": "SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_INGRESS_BIND",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_HTTP_URL",
    "apiGatewayBaseUrl": "SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL"
    },
    "application.backend-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_URL"
    },
    "application.open-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "cloudPublicHosts": {
    "application.public-ingress": {
      "httpHost": "documents.sdkwork.com"
    },
    "application.backend-http": {
      "httpHost": "documents-admin.sdkwork.com"
    },
    "application.open-http": {
      "httpHost": "doc.sdkwork.com"
    },
    "platform.api-gateway": {
      "httpHost": "api.sdkwork.com"
    }
  },
  "database": {
    "appPrefix": "SDKWORK_DOCUMENTS"
  },
  "components": {
    "appApiRouter": {
      "crate": "sdkwork-documents-standalone-gateway",
      "binary": "sdkwork-documents-app-api"
    },
    "backendApiRouter": {
      "crate": "sdkwork-documents-standalone-gateway",
      "binary": "sdkwork-documents-backend-api"
    },
    "openApiRouter": {
      "crate": "sdkwork-documents-standalone-gateway",
      "binary": "sdkwork-documents-open-api"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-documents-standalone-gateway",
            "binary": "sdkwork-documents-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "pc-renderer",
            "package": "apps/sdkwork-documents-pc",
            "script": "dev",
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.development": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-documents-standalone-gateway",
            "binary": "sdkwork-documents-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "pc-renderer",
            "package": "apps/sdkwork-documents-pc",
            "script": "dev",
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "standalone.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-documents-standalone-gateway",
            "binary": "sdkwork-documents-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "pc-renderer",
            "package": "apps/sdkwork-documents-pc",
            "script": "dev",
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      }
    }
  },
  "packaging": {
    "cloudConfigFiles": [],
    "targets": [
      {
        "id": "container-noarch-cloud-container-config-bundle-tar-gz",
        "profile": "container",
        "platform": "container",
        "architecture": "noarch",
        "formats": [
          "tar.gz"
        ],
        "runner": "ubuntu-24.04",
        "outputGlob": "dist/cloud-config/sdkwork-documents-api-gateway-config-*.tar.gz",
        "deploymentProfile": "cloud",
        "runtimeTarget": "container",
        "variant": "config-bundle"
      }
    ]
  },
  "scripts": {
    "dev": "scripts/documents-dev.mjs"
  },
  "retired": {
    "envKeys": [
      "PORT"
    ]
  }
}
