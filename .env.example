# Safe checked-in example for SDKWork Documents local development.
# Copy to `.env` or `.env.local` and replace credentials before running `pnpm dev`.

SDKWORK_DOCUMENTS_ENVIRONMENT=development
SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE=standalone
SDKWORK_DOCUMENTS_SERVICE_LAYOUT=unified-process
SDKWORK_DOCUMENTS_DEV_AUTH_BYPASS=true
SDKWORK_DOCUMENTS_TENANT_ID=1
SDKWORK_DOCUMENTS_USER_ID=10
SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18084
SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18084

DOCUMENTS_DATABASE_ENGINE=postgresql
DOCUMENTS_DATABASE_HOST=127.0.0.1
DOCUMENTS_DATABASE_PORT=5432
DOCUMENTS_DATABASE_NAME=sdkwork_documents_dev
DOCUMENTS_DATABASE_SCHEMA=public
DOCUMENTS_DATABASE_USERNAME=sdkwork_documents_dev
DOCUMENTS_DATABASE_PASSWORD=change-me
DOCUMENTS_DATABASE_SSL_MODE=disable
DOCUMENTS_DATABASE_MAX_CONNECTIONS=10
