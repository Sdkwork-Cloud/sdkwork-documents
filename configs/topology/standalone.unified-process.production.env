# Documents topology profile: standalone + unified-process + production

SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE=standalone
SDKWORK_DOCUMENTS_SERVICE_LAYOUT=unified-process
SDKWORK_DOCUMENTS_ENVIRONMENT=production
SDKWORK_DOCUMENTS_CONFIG_PROFILE=prod
SDKWORK_DOCUMENTS_RUNTIME_TARGET=server
SDKWORK_DOCUMENTS_PROFILE_ID=standalone.unified-process.production

SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18084
SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18084
SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_BIND=0.0.0.0:18084
SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18084
SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_BIND=0.0.0.0:18084
SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18084

DOCUMENTS_DATABASE_ENGINE=postgresql
DOCUMENTS_DATABASE_HOST=db.example.com
DOCUMENTS_DATABASE_PORT=5432
DOCUMENTS_DATABASE_NAME=sdkwork_documents
DOCUMENTS_DATABASE_SCHEMA=public
DOCUMENTS_DATABASE_USERNAME=sdkwork_documents
DOCUMENTS_DATABASE_PASSWORD_FILE=/etc/sdkwork/documents-database.secret
DOCUMENTS_DATABASE_SSL_MODE=require
DOCUMENTS_DATABASE_MAX_CONNECTIONS=16

SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_AUTOSTART=false

VITE_SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_DOCUMENTS_ENVIRONMENT=production
VITE_SDKWORK_DOCUMENTS_CONFIG_PROFILE=prod
VITE_SDKWORK_DOCUMENTS_BUILD_MODE=production
VITE_SDKWORK_DOCUMENTS_RUNTIME_TARGET=desktop
VITE_SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18084
VITE_SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18084
VITE_SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18084
VITE_SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
