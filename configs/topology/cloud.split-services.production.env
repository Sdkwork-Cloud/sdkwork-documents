# Documents topology profile: cloud + split-services + production

SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE=cloud
SDKWORK_DOCUMENTS_SERVICE_LAYOUT=split-services
SDKWORK_DOCUMENTS_ENVIRONMENT=production
SDKWORK_DOCUMENTS_CONFIG_PROFILE=prod
SDKWORK_DOCUMENTS_RUNTIME_TARGET=container
SDKWORK_DOCUMENTS_PROFILE_ID=cloud.split-services.production

DOCUMENTS_DATABASE_ENGINE=postgresql
DOCUMENTS_DATABASE_HOST=db.example.com
DOCUMENTS_DATABASE_PORT=5432
DOCUMENTS_DATABASE_NAME=sdkwork_documents
DOCUMENTS_DATABASE_SCHEMA=public
DOCUMENTS_DATABASE_USERNAME=sdkwork_documents
DOCUMENTS_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/documents-database-password
DOCUMENTS_DATABASE_SSL_MODE=require
DOCUMENTS_DATABASE_MAX_CONNECTIONS=32

SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL=https://documents.sdkwork.com/app/v3/api
SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_URL=https://documents-admin.sdkwork.com/backend/v3/api
SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_URL=https://doc.sdkwork.com/doc/v3/api

SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_AUTOSTART=false
SDKWORK_API_GATEWAY_CONFIG=configs/sdkwork-api-gateway.documents.production.toml

VITE_SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_DOCUMENTS_ENVIRONMENT=production
VITE_SDKWORK_DOCUMENTS_CONFIG_PROFILE=prod
VITE_SDKWORK_DOCUMENTS_BUILD_MODE=production
VITE_SDKWORK_DOCUMENTS_RUNTIME_TARGET=browser
VITE_SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL=https://documents.sdkwork.com/app/v3/api
VITE_SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_URL=https://documents-admin.sdkwork.com/backend/v3/api
VITE_SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_URL=https://doc.sdkwork.com/doc/v3/api
VITE_SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
