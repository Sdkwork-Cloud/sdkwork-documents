# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_documents_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE=standalone
SDKWORK_DOCUMENTS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_DOCUMENTS_PROFILE_ID=standalone.demo
SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL=https://documents-demo.sdkwork.com
SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_URL=https://documents-admin-demo.sdkwork.com
SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_URL=https://documents-open-demo.sdkwork.com
