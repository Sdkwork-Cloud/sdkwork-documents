
SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE=cloud
SDKWORK_DOCUMENTS_ENVIRONMENT=development
SDKWORK_DOCUMENTS_CONFIG_PROFILE=dev
SDKWORK_DOCUMENTS_RUNTIME_TARGET=container
SDKWORK_DOCUMENTS_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DOCUMENTS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18084
SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_BIND=127.0.0.1:18085
SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_URL=https://api-dev.sdkwork.com/backend/v3/api
SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_BIND=127.0.0.1:18086
SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_URL=https://api-dev.sdkwork.com/doc/v3/api
SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

VITE_SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_DOCUMENTS_ENVIRONMENT=development
VITE_SDKWORK_DOCUMENTS_CONFIG_PROFILE=dev
VITE_SDKWORK_DOCUMENTS_BUILD_MODE=development
VITE_SDKWORK_DOCUMENTS_RUNTIME_TARGET=browser
VITE_SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_DOCUMENTS_APPLICATION_BACKEND_HTTP_URL=https://api-dev.sdkwork.com/backend/v3/api
VITE_SDKWORK_DOCUMENTS_APPLICATION_OPEN_HTTP_URL=https://api-dev.sdkwork.com/doc/v3/api
VITE_SDKWORK_DOCUMENTS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_DOCUMENTS_PC_DEV_PORT=3902


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
